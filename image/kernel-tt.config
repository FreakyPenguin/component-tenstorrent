# Config fragment merged over image-builder's config-5.15.93 to make the
# SimBricks custom kernel able to host tt-kmd.
#
# The stock config is trimmed for fast boot under gem5 and leaves these off,
# which is why tt-kmd's modpost fails against it with undefined
# hwmon_device_register_with_info / dma_buf_export / dma_buf_move_notify.
# Everything else tt-kmd needs (PCI MSI, hugetlbfs, module loading) is already
# enabled there.

# telemetry.c registers a hwmon device: hwmon_device_register_with_info(),
# hwmon_device_unregister().
CONFIG_HWMON=y

# memory.c exports device memory as dma-buf: dma_buf_export(), dma_buf_put(),
# dma_resv_lock()/unlock(). CONFIG_DMA_SHARED_BUFFER has no prompt of its own --
# it is only ever `select`ed by another option -- so setting it directly would be
# dropped by olddefconfig. SYNC_FILE is the user-selectable option that selects
# it. build-tt-kernel.sh asserts DMA_SHARED_BUFFER actually ended up =y.
CONFIG_SYNC_FILE=y

# dma_buf_move_notify(), which tt-kmd calls (as dma_buf_invalidate_mappings, a
# compatibility macro on kernels before 7.1) to revoke exported mappings.
CONFIG_DMABUF_MOVE_NOTIFY=y

# Keep this kernel distinguishable from the stock 5.15.93 already installed in
# the base image, so both can coexist and the right one is named unambiguously
# in /etc/simbricks-kernel-version.
CONFIG_LOCALVERSION="-tt"
